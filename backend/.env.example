MONGODB_URI=mongodb://localhost:27017/gateway_db
REDIS_URL=redis://localhost:6379

# better-auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change_me_to_a_random_32plus_char_string
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# SMTP for password reset / account verification emails
# Leave blank to fall back to console log in development
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=Gatekeeper <noreply@example.com>

API_KEY_HEADER=x-api-key
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
NODE_ENV=development
PORT=9000
